# Copy to .env.local for local overrides.
# This foundation does not require secrets. Do not put credentials in this file.
# localhost is a local placeholder. It is rejected as a production origin, so it
# does not create canonical URLs, sitemap entries, or search indexing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave both unset. Search indexing requires all three of: a validated https
# NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_ALLOW_INDEXING exactly "true", and
# AXXIS_VERIFIED_PRODUCTION exactly "true". NODE_ENV=production is not enough.
# Do not set the flags on preview or staging.
# NEXT_PUBLIC_ALLOW_INDEXING=
# AXXIS_VERIFIED_PRODUCTION=
